# Copy to .env and edit. NEVER commit .env.
DATABASE_URL=sqlite:///./pulsewatch.db
# For Postgres: postgresql+psycopg://pulsewatch:devpassword@localhost:5432/pulsewatch
SECRET_KEY=change-me-to-a-long-random-string
# Set true only if you want to monitor localhost/private services in local dev
ALLOW_PRIVATE_TARGETS=false
# Dev shortcut: create tables automatically instead of running `alembic upgrade head`
AUTO_CREATE_TABLES=false
# Run the scheduler inside the web process (handy for free hosting). Default: separate process.
EMBEDDED_SCHEDULER=false
# Optional email alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=pulsewatch@example.com
